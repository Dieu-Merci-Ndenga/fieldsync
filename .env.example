# API (backend/)
PORT=3000
DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5432/fieldsync
# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
API_TOKEN=
# Comma-separated allowed browser origins, or * for any (dev only). CORS is disabled when empty.
# The browser (Expo web) build needs this; native apps do not.
CORS_ORIGIN=
UPLOAD_DIR=./uploads

# Mobile (mobile/) — public by design, never put real secrets in EXPO_PUBLIC_* for a store build
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_API_TOKEN=
